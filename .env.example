# Environment Configuration for ScrapMaster AI

# Database Configuration
DATABASE_URL=sqlite:///./data/scrapmaster.db

# Security & Secrets
SECRET_KEY=change-me-in-production-with-secure-random-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Storage Configuration
LOCAL_STORAGE_DIR=./data
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=3600

# Motion Analysis Configuration
MOTION_FRAME_LIMIT=60
MOTION_CONFIDENCE_THRESHOLD=0.4
MOTION_DELTA_THRESHOLD=20.0

# Local AI Configuration
ENABLE_OPENCV=True
ENABLE_OLLAMA=False
OLLAMA_BASE_URL=http://localhost:11434
ENABLE_WHISPER=False
WHISPER_MODEL=base

# Monitoring
ENABLE_AUDIT_LOGS=True
ENABLE_METRICS=True
METRICS_EXPORT_INTERVAL_SECONDS=60

# CORS
CORS_ORIGINS=*

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development
